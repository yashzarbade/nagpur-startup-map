# Database
DATABASE_URL=postgresql://username:password@ep-your-endpoint.region.aws.neon.tech/neondb

# Site
NEXT_PUBLIC_SITE_URL=https://centralindiatech.com

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mapbox GL JS Public Access Token
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Job Sync & Automation (used by GitHub Actions cron and admin sync)
CRON_SECRET=your-cron-secret-here

# Telegram Collector (Optional - for Telegram job & walk-in channel ingestion)
# TELEGRAM_API_ID=your-telegram-api-id
# TELEGRAM_API_HASH=your-telegram-api-hash
# TELEGRAM_SESSION=your-telegram-session-string
